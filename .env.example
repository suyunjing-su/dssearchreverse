# OpenAI-compatible upstream endpoint. The model must have native web search enabled.
UPSTREAM_BASE_URL=https://api.example.com
UPSTREAM_CHAT_PATH=/v1/chat/completions
UPSTREAM_API_KEY=
UPSTREAM_MODEL=search-enabled-model

# Request and validation limits
UPSTREAM_TIMEOUT_SECONDS=60
UPSTREAM_MAX_RETRIES=2
MAX_QUERY_CHARS=4000
MAX_RESULTS=10
MAX_DOMAINS=10

# Optional: JSON object merged into request headers, e.g. {"api-version":"2024-xx"}
UPSTREAM_EXTRA_HEADERS_JSON={}

# Optional system prompt. Keep the native-search instruction in place.
UPSTREAM_SYSTEM_PROMPT=You are a web research assistant with native web search enabled.

# Used by Streamable HTTP transport; stdio ignores these values.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
